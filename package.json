{
  "name": "financial-tracker",
  "version": "1.0.0",
  "description": "Income and expense tracker API",
  "scripts": {
    "start": "node -r @babel/register index.js",
    "dev": "nodemon -r @babel/register index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "jest": {
    "preset": "@shelf/jest-mongodb",
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "financial-tracker-fe/"
    ],
    "watchPathIgnorePatterns": ["globalConfig"],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/register": "^7.25.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.15.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
